# AGRIFLOW Environment Variables Configuration

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database & Supabase Configuration
# For local dev without Supabase PostgreSQL, SQLite fallback will automatically be used if unset
DATABASE_URL=sqlite:///./agriflow.db
# SUPABASE_URL=https://your-supabase-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT & Authentication Secret
JWT_SECRET=agriflow_production_secret_key_change_in_prod_2026_super_secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Twilio SMS API Credentials (Real Integration)
# Populate with valid Twilio credentials for real SMS delivery to phones
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Maps & Departure Time Integration (Future Google Maps / Mapbox interface)
GOOGLE_MAPS_API_KEY=

# App Metadata
VITE_API_URL=http://localhost:8000
