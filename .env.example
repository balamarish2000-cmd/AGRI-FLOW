# ==============================================================================
# AGRI-FLOW Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Backend Server Configuration
PROJECT_NAME="AGRIFLOW Platform"
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./agriflow.db
# PostgreSQL (Production / Supabase):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agriflow

# Optional Supabase Integration
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Twilio SMS Telephony Integration
# Obtain credentials from Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=AC_sample_twilio_account_sid_replace_with_actual
TWILIO_AUTH_TOKEN=sample_twilio_auth_token_replace_with_actual
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_STATUS_CALLBACK_URL=http://your-server-ip:8000/api/notifications/twilio-status-callback

# Razorpay Payment Gateway (Test / Live Mode)
# Obtain test credentials from Razorpay Dashboard: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key
RAZORPAY_MODE=test

# Maps & Geolocation API (Optional for transit calculations)
GOOGLE_MAPS_API_KEY=

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_URL=http://localhost:8000
